# .gitignore

# Python cache & tooling
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Environment secrets — NEVER commit this
.env

# Local database & cache artifacts
data/**/*.db
*.duckdb*
.backfill_cache.json

# dbt compilation & package targets
dbt/target/
dbt/dbt_packages/
dbt/logs/

# Log files — broad exclusion first, then allow daily and latest scraper logs
*.log
logs/*
!logs/.gitkeep
!logs/scraper.log
!logs/scraper_*.log

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/

# Local documentation & reports
docs/
