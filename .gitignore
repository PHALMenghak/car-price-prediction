# .gitignore

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Environment secrets — NEVER commit this
.env

# Scraped data output — tracked by git so GitHub Actions can push results back.
# Exclude only local DB files which are never needed in the repo.
data/**/*.db

# Log files — broad exclusion first, then allow scraper.log (order matters in .gitignore)
*.log
logs/*
!logs/.gitkeep
!logs/scraper.log

# Jupyter notebook checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# IDE files
.idea/
.vscode/

khmer24-data-scientist-intern-scraping-playbook.md
PROJECT_PLAN.md